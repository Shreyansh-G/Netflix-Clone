# Copy this file to ".env" in the project root and fill in real values.
# The real .env is git-ignored — never commit your secrets.

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_ID=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/netflix?retryWrites=true&w=majority

# Port the backend listens on
PORT=5000

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# "development" or "production"
NODE_ENV=development

# TMDB API Read Access Token (v4 auth) — sent as a Bearer token.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_read_access_token
